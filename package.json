{
    "name": "double-calculatrice",
    "version": "1.0.0",
    "description": "Double calculator web app",
    "main": "main.js",
    "scripts": {
        "start": "echo 'No server script'",
        "build": "echo 'No build step'",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathIgnorePatterns=tests/e2e",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --testPathIgnorePatterns=tests/e2e",
        "lint": "eslint . --ext .js,.mjs,.cjs --max-warnings 0",
        "format": "prettier --write main.js advanced-features.js scientific.mjs tests/scientific.test.mjs tests/e2e/*.mjs tests/load/*.mjs eslint.config.mjs playwright.config.mjs release.config.cjs lighthouserc.cjs package.json .github/workflows/*.yml",
        "format:check": "prettier --check main.js advanced-features.js scientific.mjs tests/scientific.test.mjs tests/e2e/*.mjs tests/load/*.mjs eslint.config.mjs playwright.config.mjs release.config.cjs lighthouserc.cjs package.json .github/workflows/*.yml",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:lighthouse": "lhci autorun",
        "test:load": "node tests/load/scientific-load.mjs"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.62.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/github": "^11.0.6",
        "@semantic-release/npm": "^12.0.2",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "eslint": "^10.9.1",
        "globals": "^17.11.0",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "semantic-release": "^24.2.9"
    }
}
