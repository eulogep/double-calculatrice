{
    "name": "double-calculatrice",
    "version": "1.0.0",
    "description": "Double calculator web app",
    "main": "main.js",
    "scripts": {
        "start": "echo 'No server script'",
        "build": "node scripts/build-static.mjs",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathIgnorePatterns=tests/e2e",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch --testPathIgnorePatterns=tests/e2e",
        "lint": "eslint . --ext .js,.mjs,.cjs --max-warnings 0",
        "format": "prettier --write index.html main.js advanced-features.js scientific.mjs tests/scientific.test.mjs tests/e2e/*.mjs tests/load/*.mjs scripts/*.mjs eslint.config.mjs playwright.config.mjs release.config.cjs package.json .github/workflows/*.yml .github/release-drafter.yml .github/dependabot.yml",
        "format:check": "prettier --check index.html main.js advanced-features.js scientific.mjs tests/scientific.test.mjs tests/e2e/*.mjs tests/load/*.mjs scripts/*.mjs eslint.config.mjs playwright.config.mjs release.config.cjs package.json .github/workflows/*.yml .github/release-drafter.yml .github/dependabot.yml",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:lighthouse": "node scripts/run-lighthouse.mjs",
        "test:load": "node tests/load/scientific-load.mjs",
        "refactor:sonar:js:check": "node scripts/refactor-sonar-js.mjs --check",
        "refactor:sonar:js": "node scripts/refactor-sonar-js.mjs --apply"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "lighthouse": "^13.4.1",
        "@playwright/test": "^1.62.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "eslint": "^10.9.1",
        "globals": "^17.11.0",
        "jest": "^30.4.2",
        "prettier": "^3.9.6",
        "semantic-release": "^25.0.9"
    }
}
